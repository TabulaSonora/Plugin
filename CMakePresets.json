{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    { "name": "debug",   "displayName": "Debug",   "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "displayName": "Release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    {
      "name": "vcpkg",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "TSPLUG_FETCH_NLOHMANN_JSON": "OFF" }
    },
    { "name": "debug-vcpkg",   "displayName": "Debug (vcpkg for nlohmann_json)",   "inherits": "vcpkg", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release-vcpkg", "displayName": "Release (vcpkg for nlohmann_json)", "inherits": "vcpkg", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    {
      "name": "xcode",
      "displayName": "Xcode project (for debugging inside a host)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64", "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0" }
    },
    {
      "name": "universal",
      "displayName": "Release, arm64 + x86_64",
      "inherits": "release",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "universal", "configurePreset": "universal" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
