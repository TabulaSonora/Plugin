<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A hardened-runtime plugin is loaded into hosts that may not be, and the Standalone plays
         through CoreAudio; neither needs anything beyond the defaults. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>
</dict>
</plist>
